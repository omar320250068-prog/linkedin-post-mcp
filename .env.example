# Copy this file to .env and paste your LinkedIn member access token.
# Token source: LinkedIn Developer App -> Auth tab -> "OAuth 2.0 tools" -> Create token
# Scopes required: openid  profile  w_member_social
LINKEDIN_ACCESS_TOKEN=
# Optional overrides:
# LINKEDIN_VERSION=202506
# LINKEDIN_AUTHOR_URN=urn:li:person:xxxxxxxx
